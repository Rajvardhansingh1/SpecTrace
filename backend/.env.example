# Copy this file to backend/.env (the .env file is git-ignored; never commit it).
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# It works as it is: with no keys filled in, the app runs fully without the language model. To
# switch the language-model features on, paste your OpenRouter key on the line marked  <-- PASTE.
# Then check them:  python -m scripts.check_providers

# ------------------------------------------------------------------------------------------------
# Database. Leave empty to keep comparisons in memory (they are lost on restart).
# For Supabase paste the "Session pooler" connection string (Dashboard > Connect), for example
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ------------------------------------------------------------------------------------------------
SPECTRACE_DATABASE_URL=

# Browser origins allowed to call the API, as a JSON list. Add your Vercel URL after deploying.
SPECTRACE_CORS_ORIGINS=["http://localhost:3000"]

SPECTRACE_MAX_REQUEST_BYTES=12000000
SPECTRACE_RATE_LIMIT_PER_MINUTE=120
SPECTRACE_RATE_LIMIT_HEAVY_PER_MINUTE=10

# Set true only behind a proxy you control (Render), so the client address is read from the last
# X-Forwarded-For entry. Leave false otherwise; that header can be forged.
SPECTRACE_TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------------------------------------
# Language model: summaries of both versions, what changed, and questions in your own words.
# Document text is sent to the provider named here when you click Summarize or Ask.
# Default setup: OpenRouter for chat and for embeddings, with one key.
# ------------------------------------------------------------------------------------------------
SPECTRACE_LLM_PROVIDER=openrouter
# <-- PASTE YOUR OPENROUTER KEY on the next line (create one at openrouter.ai/keys)
SPECTRACE_LLM_API_KEY=
# "openrouter/free" lets OpenRouter pick a free model. Free models are rate limited hard (about
# 20 requests a minute and a small daily allowance) and their hosts may keep prompts, so use a
# paid model id from openrouter.ai/models for documents that are private.
SPECTRACE_LLM_MODEL=openrouter/free

# To use Groq for chat instead, replace the three lines above with:
#   SPECTRACE_LLM_PROVIDER=groq
#   SPECTRACE_LLM_API_KEY=your-groq-key                 (console.groq.com/keys)
#   SPECTRACE_LLM_MODEL=a-model-id-from-console.groq.com/docs/models
# Groq has no embeddings, so keep the embedding settings below (they then need their own key).

SPECTRACE_LLM_TIMEOUT_SECONDS=60
SPECTRACE_LLM_MAX_RETRIES=2
SPECTRACE_LLM_MAX_OUTPUT_TOKENS=1200
# Characters of document text placed in one prompt.
SPECTRACE_LLM_CONTEXT_CHARS=24000
# Spending guards: model calls per visitor per hour, and per server per day.
SPECTRACE_LLM_CALLS_PER_OWNER_PER_HOUR=30
SPECTRACE_LLM_CALLS_PER_DAY=1000

# ------------------------------------------------------------------------------------------------
# Embeddings: vectors that let questions find passages by meaning (stored in Supabase pgvector).
# With the chat provider set to openrouter and the key line below empty, the chat key is reused.
# ------------------------------------------------------------------------------------------------
SPECTRACE_EMBEDDING_PROVIDER=openrouter
# Leave the next line empty to reuse the OpenRouter key above.
SPECTRACE_EMBEDDING_API_KEY=
# A free embedding model on OpenRouter (zero-priced in its catalog on 2026-10-17; free models come
# and go, so list the current ones with: curl https://openrouter.ai/api/v1/embeddings/models).
SPECTRACE_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Other free embedding ids on OpenRouter: liquid/lfm-2.5-embedding-350m:free
# A very cheap paid one (about $0.02 per million tokens): openai/text-embedding-3-small
# Alternatives for the three lines above:
#   Jina AI (free-tier key from jina.ai):  provider jina,   model jina-embeddings-v3
#   No key, runs on this machine:          provider hashing (matches shared words, not meaning)
#   A real local model, no key:            provider fastembed (pip install fastembed, ~1 GB RAM)
# Changing the embedding model makes the next question re-embed that comparison.
SPECTRACE_EMBEDDING_BATCH_SIZE=64
SPECTRACE_EMBEDDING_MAX_CHUNKS_PER_RUN=2000
