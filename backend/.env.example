# Copy to backend/.env and fill in. .env is git-ignored; never commit real values.

# Supabase session pooler URL (Dashboard > Connect > Session pooler).
# Change the scheme to postgresql+psycopg:// . Leave unset to use in-memory SQLite.
SPECTRACE_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Allowed browser origins, as a JSON list.
SPECTRACE_CORS_ORIGINS=["http://localhost:3000"]

# Largest accepted request body in bytes.
SPECTRACE_MAX_REQUEST_BYTES=12000000
