# Copy to backend/.env and fill in. .env is git-ignored; never commit real values.

# Supabase session pooler URL (Dashboard > Connect > Session pooler).
# A plain postgresql:// URL also works. Leave unset to use in-memory SQLite.
SPECTRACE_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Allowed browser origins, as a JSON list.
SPECTRACE_CORS_ORIGINS=["http://localhost:3000"]

# Largest accepted request body in bytes.
SPECTRACE_MAX_REQUEST_BYTES=12000000

# Rate limits per client and minute. POST requests (which run the analysis) use the heavy limit.
SPECTRACE_RATE_LIMIT_PER_MINUTE=120
SPECTRACE_RATE_LIMIT_HEAVY_PER_MINUTE=10

# Set true only behind a proxy you control (Render), so the client IP is taken from the
# last X-Forwarded-For entry. Leave false otherwise; the header can be forged.
SPECTRACE_TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------------------------
# Language model (optional). Without it the app still compares versions and answers questions by
# matching names. With it you also get summaries of both versions and free-form questions, always
# checked against the documents. Document text is sent to the provider you configure here.
# ---------------------------------------------------------------------------------------------

# none | openrouter | groq | openai_compatible    (test = a stand-in for tests, never for production)
SPECTRACE_LLM_PROVIDER=none
SPECTRACE_LLM_API_KEY=
# A model id from your provider's catalog, for example an OpenRouter id like vendor/model-name or a
# Groq model id. Check that it exists and what it costs before using it.
SPECTRACE_LLM_MODEL=
# Only for openai_compatible (any server that speaks the OpenAI chat protocol).
SPECTRACE_LLM_BASE_URL=

SPECTRACE_LLM_TIMEOUT_SECONDS=60
SPECTRACE_LLM_MAX_RETRIES=2
SPECTRACE_LLM_MAX_OUTPUT_TOKENS=1200
# Characters of document text placed in one prompt.
SPECTRACE_LLM_CONTEXT_CHARS=24000
# Cost guards for calls to the language model and the embedding service.
SPECTRACE_LLM_CALLS_PER_OWNER_PER_HOUR=30
SPECTRACE_LLM_CALLS_PER_DAY=1000

# ---------------------------------------------------------------------------------------------
# Embeddings (optional): vectors for finding passages by meaning. Without them retrieval uses
# keywords and the dependency graph. Vectors are stored in Supabase with pgvector.
# ---------------------------------------------------------------------------------------------

# none | openrouter | jina | openai_compatible | hashing | fastembed
#   openrouter  reuses SPECTRACE_LLM_API_KEY when the LLM provider is also openrouter
#   jina        a free-tier API key from jina.ai
#   hashing     local and free, matches shared words rather than meaning (a fallback)
#   fastembed   local model, needs `pip install fastembed` and about 1 GB of memory
SPECTRACE_EMBEDDING_PROVIDER=none
SPECTRACE_EMBEDDING_API_KEY=
SPECTRACE_EMBEDDING_MODEL=
SPECTRACE_EMBEDDING_BASE_URL=
SPECTRACE_EMBEDDING_BATCH_SIZE=64
SPECTRACE_EMBEDDING_MAX_CHUNKS_PER_RUN=2000
