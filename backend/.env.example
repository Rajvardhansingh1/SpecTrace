# Copy to backend/.env and fill in. .env is git-ignored; never commit real values.

# Supabase session pooler URL (Dashboard > Connect > Session pooler).
# A plain postgresql:// URL also works. Leave unset to use in-memory SQLite.
SPECTRACE_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# Allowed browser origins, as a JSON list.
SPECTRACE_CORS_ORIGINS=["http://localhost:3000"]

# Largest accepted request body in bytes.
SPECTRACE_MAX_REQUEST_BYTES=12000000

# Rate limits per client and minute. POST requests (which run the analysis) use the heavy limit.
SPECTRACE_RATE_LIMIT_PER_MINUTE=120
SPECTRACE_RATE_LIMIT_HEAVY_PER_MINUTE=10

# Set true only behind a proxy you control (Render), so the client IP is taken from the
# last X-Forwarded-For entry. Leave false otherwise; the header can be forged.
SPECTRACE_TRUST_PROXY_HEADERS=false
